# OpenWeatherMap API Key (Free tier: 1000 calls/day)
# Sign up at: https://openweathermap.org/api
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# NOAA Tides & Currents API (No key required - free public API)
# Documentation: https://api.tidesandcurrents.noaa.gov/api/prod/

# Movement data
# Keep the frontend pointed at the local/prod backend proxy. The backend injects
# the private RMIS_API_KEY server-side. Do not put the RMIS key in the browser
# bundle for production.
VITE_API_URL=/api

# Optional dev-only fallback. Leave blank/omitted when the backend proxy is used.
# VITE_RMIS_API_KEY=your_rmis_api_key_here

# Alaska Department of Fish & Game API (if available)
# VITE_ADFG_API_KEY=your_api_key_here

# Firebase Configuration (for authentication)
# Create a project at: https://console.firebase.google.com/
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Stripe (for payments)
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here
