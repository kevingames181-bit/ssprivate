<!-- Slide 1: Title -->
<div class="slide">
    <h1>SeaScope</h1>
    <p class="subtitle">Alaska's Premier Fishery Intelligence Platform</p>
    <p class="tagline">Transforming Marine Data into Actionable Insights</p>
    <div class="contact-info">
        <p><strong>Website:</strong> www.getseascope.com</p>
